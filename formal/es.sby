# SymbiYosys: P1-P3 (monotone best_fitness, revert restores genome, no
# deadlock). Run: sby -f es.sby
[options]
mode prove
depth 25

[engines]
smtbmc z3

[script]
read -formal -sv orca_pkg.sv
read -formal -sv prng.sv
read -formal -sv genome_store.sv
read -formal -sv es_controller.sv
read -formal -sv formal_top.sv
prep -top formal_top

[files]
formal_top.sv
../src/orca_pkg.sv
../src/prng.sv
../src/genome_store.sv
../src/es_controller.sv
