  "RSZ_DONT_TOUCH_RX": "u_sensor\\.(chain|late_launch|g_dly).*",
  "PNR_SDC_FILE": "dir::orca.sdc",
  "SIGNOFF_SDC_FILE": "dir::orca.sdc",

  "//": "Full-die orca on met4: placed macro with a dummy 2x2 lef bbox in the margin, the art itself lives beyond it in the gds",
